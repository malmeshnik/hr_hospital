<odoo>
    <record id="hr_hospital_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">hr_hospital_visit_report_wizard_form</field>
        <field name="model">hr.hospital.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visits Report">
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="patient_ids" widget="many2many_tags"/>
                        <field name="desease_id"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="is_completed_visits"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" type="object"
                            string="Generate report" class="btn-primary"/>
                    <button string="Cancle" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_visit_report_wizard_from_patient" model="ir.actions.act_window">
        <field name="name">Visits Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_hr_hospital_visit_report_wizard_from_doctor" model="ir.actions.act_window">
        <field name="name">Visits Report</field>
        <field name="res_model">hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>