<odoo>

    <record id="hr_hospital_doctor_category_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.view.tree</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list string="Doctor Categories">
                <field name="sequence"/>
                <field name="name"/>
                <field name="doctor_ids" widget="one2many_tags"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_category_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.view.form</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_category_action" model="ir.actions.act_window">
        <field name="name">Doctor Categories</field>
        <field name="res_model">hr.hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_hospital_doctor_window" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>