<odoo>
    <record id="hr_hospital_desease_tree" model="ir.ui.view">
        <field name="name">hr_hospital.desease.tree ()</field>
        <field name="model">hr_hospital.desease</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_desease_form" model="ir.ui.view">
        <field name="name">hr_hospital.desease.form ()</field>
        <field name="model">hr_hospital.desease</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_desease_window" model="ir.actions.act_window">
        <field name="name">Deseases</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr_hospital.desease</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_desease"
              action="action_hr_hospital_desease_window"
              parent="hr_hospital_main_menu"
              name="Desease" sequence="200"/>
</odoo>