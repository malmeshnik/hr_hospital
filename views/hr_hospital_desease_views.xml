<odoo>
    <record id="hr_hospital_desease_tree" model="ir.ui.view">
        <field name="name">hr_hospital_desease_tree</field>
        <field name="model">hr.hospital.desease</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="parent_id" widget="many2one_tags"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_desease_form" model="ir.ui.view">
        <field name="name">hr_hospital_desease_form</field>
        <field name="model">hr.hospital.desease</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="parent_id" widget="many2one_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_desease_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.desease.view.search</field>
        <field name="model">hr.hospital.desease</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="parent_id" string="Category"
                        enable_counters="1"
                        hierarchize="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_desease_window" model="ir.actions.act_window">
        <field name="name">Deseases</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.desease</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_hospital_desease_view_search"/>
    </record>

    <menuitem id="hr_hospital_menu_desease"
              action="action_hr_hospital_desease_window"
              parent="hr_hospital_main_menu"
              name="Desease" sequence="200"/>
</odoo>