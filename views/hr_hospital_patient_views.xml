<odoo>
    <record id="hr_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr_hospital_patient_tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="insurance_number"/>
                <field name="doctor_id" widget="many2one_tags"/>
                <field name="visit_ids" widget="one2many_tags"/>
                <field name="blood_type"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="doctor_history_ids" widget="one2many_tags"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr_hospital_patient_form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_visit" type="object"
                        string="New visit" class="btn-primary"/>
                </header>
                <sheet>
                    <button name="action_view_patient_visits_history" type="object"
                            string="Patient visits history" class="btn-secondary"/>
                    <separator/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone" />
                            <field name="insurance_number"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                        <group>
                            <field name="system_user" />
                            <field name="doctor_id" widget="many2one_tags"/>
                            <field name="visit_ids" widget="one2many_tags"/>
                            <field name="doctor_history_ids" widget="one2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.view.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_patient_window" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <menuitem id="hr_hospital_menu_patient"
              action="action_hr_hospital_patient_window"
              parent="hr_hospital_main_menu"
              name="Patient" sequence="200"/>
</odoo>