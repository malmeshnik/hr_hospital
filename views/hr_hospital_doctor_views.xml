<odoo>
    <record id="hr_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hr_hospital_doctor_tree</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id" widget="many2one_tags"/>
                <field name="specialization"/>
                <field name="patient_ids" widget="many2many_tags"/>
                <field name="is_intern"/>
                <field name="mentor_id" widget="many2one_tags"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr_hospital_doctor_form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="gender" />
                            <field name="birth_date" />
                            <field name="age" />
                            <field name="blood_type" />
                            <field name="category_id" widget="many2one_tags"/>
                            <field name="specialization"/>
                            <field name="is_intern"/>
                        </group>
                        <group>
                            <field name="system_user" />
                            <field name="mentor_id" widget="many2one_tags" invisible="not mentor_id"/>
                            <field name="patient_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group string="Interns" invisible="not intern_ids">
                        <field name="intern_ids" nolable="1">
                            <kanban>
                                <template>
                                    <t t-name="card">
                                        <div class="oe_kanban_global_click">
                                            <strong><field name="name" /></strong>
                                            <div><field name="category_id" /></div>
                                            <div>
                                                <span t-if="record.gender.raw_value">
                                                    <field name="gender" />
                                                </span>
                                                <span t-if="record.birth_date.raw_value">
                                                    | <field name="birth_date"/>
                                                </span>
                                                <span t-if="record.age.raw_value">
                                                    (<field name="age"/> y.)
                                                </span>
                                            </div>
                                            <div t-if="record.blood_type.raw_value">
                                                Blood Type: <field name="blood_type" />
                                            </div>
                                            <div>
                                                Mentor: <field name="mentor_id" />
                                            </div>
                                        </div>
                                    </t>
                                </template>
                            </kanban>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.view.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />

                <filter name="filter_interns" string="Interns" domain="[('is_intern', '=', True)]"/>
                <filter name="filter_mentors" string="Mentors" domain="[('intern_ids', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="hr_hospital_doctor_view_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.view.kanban</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" quick_create='true'>
                
                <field name="category_id" />
                <field name="is_intern" />
                <field name="mentor_id" />
                <templates>
                    <t t-name="card">
                        <strong><field name="name" /></strong>
                        <field name="specialization" />
                        <field name="birth_date" />
                        <field name="category_id" />
                        <field name="is_intern" />
                        <field name="mentor_id" />
                        <div t-if="record.is_intern.raw_value">
                            <span class="badge text-bg-info">Intern</span>
                        </div>

                        <div t-if="record.mentor_id.raw_value">
                            Mentor: <field name="mentor_id" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_hospital_doctor_window" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="hr_hospital_menu_doctor"
              action="action_hr_hospital_doctor_window"
              parent="hr_hospital_main_menu"
              name="Doctor" sequence="200"/>
</odoo>