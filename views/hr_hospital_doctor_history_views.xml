<odoo>

    <record id="hr_hospital_doctory_history_tree" model="ir.ui.view">
        <field name="name">hr_hospital_doctor_history_tree</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">hr_hostpital_doctor_history_form</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="assign_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_doctor_history_window" model="ir.actions.act_window">
        <field name="name">Doctor History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
